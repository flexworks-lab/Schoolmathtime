{
  "name": "schoolmathtime",
  "version": "1.0.0",
  "private": true,
  "description": "A configurable, read-only educational web gateway",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check public/app.js && node --check public/proxy-chrome.js && node --check public/ultraviolet.js"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "express-session": "1.19.0",
    "helmet": "8.1.0",
    "ipaddr.js": "2.2.0",
    "@mercuryworkshop/bare-mux": "2.1.9",
    "@mercuryworkshop/epoxy-transport": "2.1.28",
    "@titaniumnetwork-dev/ultraviolet": "3.2.10",
    "@mercuryworkshop/wisp-js": "0.5.0"
  }
}
