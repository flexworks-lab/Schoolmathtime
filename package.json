{
  "name": "schoolmathtime",
  "version": "1.0.0",
  "private": true,
  "description": "A configurable, read-only educational web gateway",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check public/app.js && npm test",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "express-session": "1.19.0",
    "helmet": "8.1.0",
    "ipaddr.js": "2.2.0"
  }
}
