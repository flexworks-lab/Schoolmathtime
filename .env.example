# Required. Set a long, random value; never expose it in frontend code.
PROXY_ACCESS_KEY=replace-with-a-long-random-access-key

# Required. Used to sign session cookies. Use a different random secret.
SESSION_SECRET=replace-with-a-different-long-random-secret

# Use * to permit any public HTTPS hostname, or list approved hosts separated by commas.
# Private/internal IP targets and non-standard ports are still blocked.
ALLOWED_HOSTS=*

# Required for Google results to appear inside Schoolmathtime. Create a full-web Programmable Search Engine and paste its Search engine ID here.
GOOGLE_CSE_ID=replace-with-your-google-search-engine-id

PORT=3000
NODE_ENV=development
