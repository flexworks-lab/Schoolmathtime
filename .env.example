# Use * to permit any public HTTPS hostname, or list approved hosts separated by commas.
# Private/internal IP targets and non-standard ports are still blocked.
ALLOWED_HOSTS=*

PORT=3000
NODE_ENV=development

# Optional: server-side YouTube Data API v3 key (keep this secret; never put it in public JS).
YOUTUBE_API_KEY=
# Maximum uncached API searches allowed per rolling 24-hour window (default 80, max 90).
YOUTUBE_SEARCH_DAILY_CAP=80


# Optional: official Google OAuth for read-only YouTube account access.
# Create a Web application OAuth client in Google Cloud. Keep the secret on the server.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match the callback registered in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
